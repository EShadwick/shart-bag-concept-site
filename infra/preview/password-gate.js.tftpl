// CloudFront Function (cloudfront-js-2.0), viewer-request.
// Asks for the shared preview username and password before anything is served.
function handler(event) {
  var request = event.request;
  var auth = request.headers.authorization;
  var expected = "Basic ${credentials}";

  if (!auth || auth.value !== expected) {
    return {
      statusCode: 401,
      statusDescription: "Unauthorized",
      headers: {
        "www-authenticate": { value: "Basic realm=\"Shart Bag concept preview\", charset=\"UTF-8\"" },
        "cache-control": { value: "no-store" }
      }
    };
  }
  return request;
}
